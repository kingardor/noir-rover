# noir-rover configuration
# Copy this file to .env and edit. .env is gitignored.

# ─── Test mode ────────────────────────────────────────────────────────────────
# 1 = no robot required. Bridge skips ROS init, returns synthetic sensors,
# motion commands are no-ops. Also auto-starts the test-feed Tilt resource,
# which replays recordings/test_feed.mp4 as the camera feed.
TEST_MODE=0

# ─── Agent LLM provider ───────────────────────────────────────────────────────
# "mlx"        → local Qwen3-VL-2B-Instruct-4bit via mlx_vlm.server on :8000
# "openrouter" → cloud via OpenRouter (needs OPENROUTER_API_KEY below)
AGENT_PROVIDER=mlx

# Required only when AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# ─── ROS / robot network ──────────────────────────────────────────────────────
# ROS_IP must be your Mac's address on the robot subnet.
# The Scout creates a 10.42.0.x network over USB-C Ethernet.
# Find your IP: ifconfig | grep 10.42.
ROS_MASTER_URI=http://10.42.0.1:11311
ROS_IP=10.42.0.181

# ─── Optional overrides (all have sane defaults in code) ──────────────────────
# AGENT_MODEL=mlx-community/Qwen3-VL-2B-Instruct-4bit
# MLX_VLM_URL=http://localhost:8000
# REDIS_URL=redis://localhost:6380
# BRIDGE_URL=http://localhost:8012

# Knowledge graph sampling
# KG_SAMPLE_INTERVAL=3.0   # seconds between frame samples
# KG_FRAMES=3              # rolling buffer size; fires VLM when full + fresh

# VLM / audio model overrides
# VLM_MODEL=mlx-community/Qwen3-VL-2B-Instruct-4bit
# STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# TTS_MODEL=mlx-community/Kokoro-82M-4bit
# TTS_VOICE=af_heart
